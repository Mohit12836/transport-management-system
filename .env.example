# NextGen Transport Management System (TMS Pro) - Environment Variables
# Copy this file to .env.local for local development or set in your deployment provider (Vercel, Supabase).

# ==========================================
# 1. APPLICATION CORE
# ==========================================
NEXT_PUBLIC_APP_NAME="NextGen Transport Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# 2. SUPABASE POSTGRESQL & AUTH (DATABASE LAYER)
# ==========================================
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Database Connection URI (for running migrations or pooling via Supavisor port 6543)
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# STRICT SECURITY: Supabase Service Role Key (Used ONLY by server-side API handlers and storage guards)
# NEVER expose this key to browser code or NEXT_PUBLIC_* variables!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Secure Private Storage Bucket Names
SUPABASE_STORAGE_POD_BUCKET="pod-receipts"
SUPABASE_STORAGE_COMPLIANCE_BUCKET="driver-compliance"

# ==========================================
# 3. EXTERNAL PRODUCTION INTEGRATIONS
# Leave empty to keep system running in transparent UNCONFIGURED mode.
# ==========================================

# Official WhatsApp Cloud API (WACA / Meta Graph API)
# Used for real-time dispatch alerts, driver LR delivery links, and OTP receipts
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# NPCI NETC FASTag API (Toll Verification & Balance Auto-Check)
FASTAG_NPCI_API_KEY=""
FASTAG_MERCHANT_ID=""
FASTAG_API_ENDPOINT=""

# GPS Telematics & Vehicle Tracking (MapmyIndia / Mappls / Fleetx / Traccar)
GPS_TRACKING_API_KEY=""
GPS_TRACKING_PROVIDER="" # 'mappls' | 'fleetx' | 'traccar'

# Payment Gateway (Razorpay - Driver Instant Advance Payouts & Customer Collections)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_ACCOUNT_NUMBER=""

# Government GST & E-Way Bill Portal API (NIC GSP)
EWAYBILL_GSP_CLIENT_ID=""
EWAYBILL_GSP_CLIENT_SECRET=""
EWAYBILL_AUTH_TOKEN=""
